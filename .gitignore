*.local.sql
coverage

# Claves y salidas del publicador de fichas (nunca versionar)
CLAVES.local.txt
RESULTADO.local.txt

# Cargas de asesorados: SIEMPRE traen datos personales (nombres, correos,
# medidas, notas de salud). Nunca deben entrar al repo.
supabase/_app-cargar-*.sql

# Estado local del CLI de Supabase
supabase/.temp/

# Lienzos de diseño: las FUENTES sí van al repo (`*.dc.html`, `canvas.json`),
# los payloads sembrados NO. Son 5,8 MB de editor empaquetado que se regeneran
# con el sembrador a partir de esas fuentes, y una vez en el historial ya no se
# pueden sacar. Ver `docs/diseno/`.
docs/diseno/*/salon-*.html
docs/diseno/*/previa.html
